{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ar-aipet.local/protocol/sensor-observation.schema.json",
  "type": "object",
  "required": ["version", "observationId", "deviceId", "sensorType", "observedAt", "value", "confidence", "unit", "source", "privacyClass"],
  "properties": {
    "version": {"type": "string"},
    "observationId": {"type": "string", "format": "uuid"},
    "deviceId": {"type": "string"},
    "sensorType": {"type": "string", "enum": ["camera.face", "microphone.asr", "touch", "imu", "base.odometry"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "value": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "unit": {"type": "string"},
    "source": {"type": "string"},
    "privacyClass": {"type": "string"}
  },
  "additionalProperties": false
}
