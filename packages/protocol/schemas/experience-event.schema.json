{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ar-aipet.local/protocol/experience-event.schema.json",
  "type": "object",
  "required": ["version", "eventId", "sourceEventId", "personaId", "mode", "priority", "expiresAt", "speech", "innerOs", "robot", "xr", "app", "interruptible"],
  "properties": {
    "version": {"type": "string"},
    "eventId": {"type": "string", "format": "uuid"},
    "sourceEventId": {"type": ["string", "null"]},
    "personaId": {"type": "string"},
    "mode": {"type": "string", "enum": ["conversation", "reminder", "farm", "game", "sensor", "companion"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "expiresAt": {"type": "string", "format": "date-time"},
    "speech": {"type": "object", "required": ["text", "emotion", "interruptible"], "properties": {"text": {"type": "string"}, "emotion": {"type": "string"}, "interruptible": {"type": "boolean"}}, "additionalProperties": false},
    "innerOs": {"type": "object", "required": ["text", "durationMs", "anchor"], "properties": {"text": {"type": "string"}, "durationMs": {"type": "integer", "minimum": 0}, "anchor": {"type": "string"}}, "additionalProperties": false},
    "robot": {"type": "object", "required": ["actions"], "properties": {"actions": {"type": "array", "items": {"type": "object", "required": ["actionId", "intent", "parameters"], "properties": {"actionId": {"type": "string", "format": "uuid"}, "intent": {"type": "string"}, "parameters": {"type": "object"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "xr": {"type": "object", "required": ["visible", "mode", "displayActionId"], "properties": {"visible": {"type": "boolean"}, "mode": {"type": "string"}, "displayActionId": {"type": ["string", "null"], "format": "uuid"}, "expression": {"type": "object", "required": ["emotion", "face", "emoji", "intensity"], "properties": {"emotion": {"type": "string"}, "face": {"type": "string"}, "emoji": {"type": "string"}, "intensity": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}}, "additionalProperties": false},
    "app": {"type": "object", "required": ["refresh", "section"], "properties": {"refresh": {"type": "boolean"}, "section": {"type": "string"}}, "additionalProperties": false},
    "interruptible": {"type": "boolean"}
  },
  "additionalProperties": false
}
