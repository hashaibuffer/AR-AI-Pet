@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstdint>
+
+class NanoDriveBleScanner {
+public:
+    static NanoDriveBleScanner& GetInstance();
+
+    void Start();
+
+private:
+    NanoDriveBleScanner() = default;
+    NanoDriveBleScanner(const NanoDriveBleScanner&) = delete;
+    NanoDriveBleScanner& operator=(const NanoDriveBleScanner&) = delete;
+
+    static void GapCallback(int event, void* param);
+    static void ScanTaskTrampoline(void* arg);
+    void ScanTask();
+    void HandleGapEvent(int event, void* param);
+
+    bool started_ = false;
+    void* event_group_ = nullptr;
+    std::uint32_t scan_cycle_ = 0;
+};
diff --git a/firmware/main/boards/stackchan/nanodrive_ble_scanner.cc b/firmware/main/boards/stackchan/nanodrive_ble_scanner.cc
new file mode 100644
index 0000000..b926708
--- /dev/null
+++ b/firmware/main/boards/stackchan/nanodrive_ble_scanner.cc
@@ -0,0 +1,233 @@
+#include "nanodrive_ble_scanner.h"
+
+#include <array>
+#include <cstdio>
+#include <cstring>
+
+#include <esp_bt.h>
+#include <esp_bt_main.h>
+#include <esp_gap_ble_api.h>
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/event_groups.h>
+#include <freertos/task.h>
+
+namespace {
+
+constexpr EventBits_t kScanParamsReady = BIT0;
+constexpr EventBits_t kScanComplete = BIT1;
+constexpr std::uint32_t kScanSeconds = 5;
+constexpr std::size_t kMaxDevicesPerCycle = 48;
+constexpr std::size_t kAddressSize = ESP_BD_ADDR_LEN;
+
+const char* TAG = "NanoDriveBleScan";
+
+struct ScanCycleState {
+    std::array<std::array<std::uint8_t, kAddressSize>, kMaxDevicesPerCycle> addresses{};
+    std::size_t count = 0;
+};
+
+ScanCycleState scan_state;
+portMUX_TYPE scan_state_lock = portMUX_INITIALIZER_UNLOCKED;
+
+bool MarkFirstInCycle(const std::uint8_t* address) {
+    bool first = true;
+    portENTER_CRITICAL(&scan_state_lock);
+    for (std::size_t i = 0; i < scan_state.count; ++i) {
+        if (std::memcmp(scan_state.addresses[i].data(), address, kAddressSize) == 0) {
+            first = false;
+            break;
+        }
+    }
+    if (first && scan_state.count < scan_state.addresses.size()) {
+        std::memcpy(scan_state.addresses[scan_state.count].data(), address, kAddressSize);
+        ++scan_state.count;
+    }
+    portEXIT_CRITICAL(&scan_state_lock);
+    return first;
+}
+
+void ResetCycle() {
+    portENTER_CRITICAL(&scan_state_lock);
+    scan_state.count = 0;
+    portEXIT_CRITICAL(&scan_state_lock);
+}
+
+void BytesToHex(const std::uint8_t* data, std::size_t length, char* output,
+                std::size_t output_size) {
+    if (output_size == 0) return;
+    const std::size_t max_bytes = (output_size - 1) / 2;
+    length = length < max_bytes ? length : max_bytes;
+    for (std::size_t i = 0; i < length; ++i) {
+        std::snprintf(output + i * 2, output_size - i * 2, "%02X", data[i]);
+    }
+    output[length * 2] = '\0';
+}
+
+}  // namespace
+
+NanoDriveBleScanner& NanoDriveBleScanner::GetInstance() {
+    static NanoDriveBleScanner instance;
+    return instance;
+}
+
+void NanoDriveBleScanner::Start() {
+    if (started_) return;
+
+    auto controller_status = esp_bt_controller_get_status();
+    if (controller_status == ESP_BT_CONTROLLER_STATUS_IDLE) {
+        esp_bt_controller_config_t config = BT_CONTROLLER_INIT_CONFIG_DEFAULT();
+        esp_err_t err = esp_bt_controller_init(&config);
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "controller init failed: %s", esp_err_to_name(err));
+            return;
+        }
+        controller_status = esp_bt_controller_get_status();
+    }
+    if (controller_status == ESP_BT_CONTROLLER_STATUS_INITED) {
+        const esp_err_t err = esp_bt_controller_enable(ESP_BT_MODE_BLE);
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "controller enable failed: %s", esp_err_to_name(err));
+            return;
+        }
+    }
+
+    auto host_status = esp_bluedroid_get_status();
+    if (host_status == ESP_BLUEDROID_STATUS_UNINITIALIZED) {
+        const esp_err_t err = esp_bluedroid_init();
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "bluedroid init failed: %s", esp_err_to_name(err));
+            return;
+        }
+        host_status = esp_bluedroid_get_status();
+    }
+    if (host_status == ESP_BLUEDROID_STATUS_INITIALIZED) {
+        const esp_err_t err = esp_bluedroid_enable();
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "bluedroid enable failed: %s", esp_err_to_name(err));
+            return;
+        }
+    }
+
+    auto event_group = xEventGroupCreate();
+    if (event_group == nullptr) {
+        ESP_LOGE(TAG, "event group allocation failed");
+        return;
+    }
+    event_group_ = event_group;
+
+    esp_err_t err = esp_ble_gap_register_callback(
+        reinterpret_cast<esp_gap_ble_cb_t>(&NanoDriveBleScanner::GapCallback));
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "GAP callback registration failed: %s", esp_err_to_name(err));
+        vEventGroupDelete(event_group);
+        event_group_ = nullptr;
+        return;
+    }
+
+    static esp_ble_scan_params_t scan_params = {
+        .scan_type = BLE_SCAN_TYPE_ACTIVE,
+        .own_addr_type = BLE_ADDR_TYPE_PUBLIC,
+        .scan_filter_policy = BLE_SCAN_FILTER_ALLOW_ALL,
+        .scan_interval = 0x50,
+        .scan_window = 0x30,
+        .scan_duplicate = BLE_SCAN_DUPLICATE_DISABLE,
+    };
+    err = esp_ble_gap_set_scan_params(&scan_params);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "scan parameter setup failed: %s", esp_err_to_name(err));
+        return;
+    }
+
+    started_ = true;
+    if (xTaskCreate(ScanTaskTrampoline, "nanodrive_ble_scan", 4096, this, 4, nullptr) !=
+        pdPASS) {
+        ESP_LOGE(TAG, "scan task creation failed");
+        started_ = false;
+        return;
+    }
+    ESP_LOGI(TAG, "BLE diagnostic scanner initialized; no device will be connected or written");
+}
+
+void NanoDriveBleScanner::GapCallback(int event, void* param) {
+    GetInstance().HandleGapEvent(event, param);
+}
+
+void NanoDriveBleScanner::HandleGapEvent(int event_raw, void* param_raw) {
+    if (param_raw == nullptr || event_group_ == nullptr) return;
+    const auto event = static_cast<esp_gap_ble_cb_event_t>(event_raw);
+    auto* param = static_cast<esp_ble_gap_cb_param_t*>(param_raw);
+    auto event_group = static_cast<EventGroupHandle_t>(event_group_);
+
+    if (event == ESP_GAP_BLE_SCAN_PARAM_SET_COMPLETE_EVT) {
+        if (param->scan_param_cmpl.status == ESP_BT_STATUS_SUCCESS) {
+            xEventGroupSetBits(event_group, kScanParamsReady);
+        } else {
+            ESP_LOGE(TAG, "scan parameter callback status=%d", param->scan_param_cmpl.status);
+        }
+        return;
+    }
+    if (event != ESP_GAP_BLE_SCAN_RESULT_EVT) return;
+
+    const auto& result = param->scan_rst;
+    if (result.search_evt == ESP_GAP_SEARCH_INQ_CMPL_EVT) {
+        xEventGroupSetBits(event_group, kScanComplete);
+        return;
+    }
+    if (result.search_evt != ESP_GAP_SEARCH_INQ_RES_EVT || !MarkFirstInCycle(result.bda)) {
+        return;
+    }
+
+    std::uint8_t name_length = 0;
+    auto* adv_data = const_cast<std::uint8_t*>(result.ble_adv);
+    const std::uint8_t* name = esp_ble_resolve_adv_data(
+        adv_data, ESP_BLE_AD_TYPE_NAME_CMPL, &name_length);
+    if (name == nullptr) {
+        name = esp_ble_resolve_adv_data(adv_data, ESP_BLE_AD_TYPE_NAME_SHORT,
+                                        &name_length);
+    }
+    char name_buffer[64] = "<unnamed>";
+    if (name != nullptr && name_length > 0) {
+        const std::size_t copy_length =
+            name_length < sizeof(name_buffer) - 1 ? name_length : sizeof(name_buffer) - 1;
+        std::memcpy(name_buffer, name, copy_length);
+        name_buffer[copy_length] = '\0';
+    }
+
+    const std::size_t payload_length = result.adv_data_len + result.scan_rsp_len;
+    char payload_hex[ESP_BLE_ADV_DATA_LEN_MAX * 2 + 1]{};
+    BytesToHex(result.ble_adv, payload_length, payload_hex, sizeof(payload_hex));
+    ESP_LOGI(TAG,
+             "cycle=%lu addr=%02X:%02X:%02X:%02X:%02X:%02X type=%u rssi=%d name=%s adv=%s",
+             static_cast<unsigned long>(scan_cycle_), result.bda[0], result.bda[1],
+             result.bda[2], result.bda[3], result.bda[4], result.bda[5],
+             static_cast<unsigned>(result.ble_addr_type), result.rssi, name_buffer,
+             payload_hex);
+}
+
+void NanoDriveBleScanner::ScanTaskTrampoline(void* arg) {
+    static_cast<NanoDriveBleScanner*>(arg)->ScanTask();
+}
+
+void NanoDriveBleScanner::ScanTask() {
+    auto event_group = static_cast<EventGroupHandle_t>(event_group_);
+    xEventGroupWaitBits(event_group, kScanParamsReady, pdFALSE, pdTRUE, portMAX_DELAY);
+    while (true) {
+        ++scan_cycle_;
+        ResetCycle();
+        xEventGroupClearBits(event_group, kScanComplete);
+        ESP_LOGI(TAG, "scan cycle %lu start (%lu seconds)",
+                 static_cast<unsigned long>(scan_cycle_),
+                 static_cast<unsigned long>(kScanSeconds));
+        const esp_err_t err = esp_ble_gap_start_scanning(kScanSeconds);
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "scan start failed: %s", esp_err_to_name(err));
+            vTaskDelay(pdMS_TO_TICKS(2000));
+            continue;
+        }
+        xEventGroupWaitBits(event_group, kScanComplete, pdTRUE, pdTRUE,
+                            pdMS_TO_TICKS((kScanSeconds + 2) * 1000));
+        ESP_LOGI(TAG, "scan cycle %lu complete", static_cast<unsigned long>(scan_cycle_));
+        vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+}
