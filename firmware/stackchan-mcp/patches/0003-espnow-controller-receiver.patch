+    static constexpr int CONTROLLER_NEUTRAL_THRESHOLD = 150;
+    // Keep remote head control responsive without driving the servos toward
+    // their mechanical extremes. Pitch is deliberately kept well below 90°.
+    static constexpr int CONTROLLER_HEAD_YAW_LIMIT_DEG = 45;
+    static constexpr int CONTROLLER_HEAD_PITCH_MIN_DEG = 20;
+    static constexpr int CONTROLLER_HEAD_PITCH_MAX_DEG = 70;
+    static constexpr int CONTROLLER_HEAD_SPEED_DPS = 200;
