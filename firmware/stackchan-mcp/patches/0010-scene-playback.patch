+    void ApplySceneStep(const SceneStep& step) {
+        switch (step.kind) {
+            case SceneStepKind::EMOTION:
+                if (display_ != nullptr) display_->SetEmotion(step.text);
+                break;
+            case SceneStepKind::LED:
+                SetAllRgbLeds(static_cast<uint8_t>(std::clamp(step.v1, 0, 255)),
+                              static_cast<uint8_t>(std::clamp(step.v2, 0, 255)),
+                              static_cast<uint8_t>(std::clamp(step.v3, 0, 255)));
+                break;
+            case SceneStepKind::HEAD:
+                WriteHeadAngles(step.v1, step.v2, step.v3);
+                break;
+            case SceneStepKind::BASE_MOVE: {
+                const char* operation = nullptr;
+                if (strcmp(step.text, "forward") == 0) operation = "FW";
+                else if (strcmp(step.text, "backward") == 0) operation = "BW";
+                else if (strcmp(step.text, "left") == 0) operation = "TL";
+                else if (strcmp(step.text, "right") == 0) operation = "TR";
+                if (operation != nullptr) {
+                    SendNanoDriveMotion(std::string(operation) + ":" + std::to_string(step.v1));
+                }
+                break;
+            }
+            case SceneStepKind::BASE_STOP:
+                WriteNanoDriveCommand("ST");
+                break;
+        }
+    }
+
+    static void SceneTaskTrampoline(void* arg) {
+        static_cast<StackChanBoard*>(arg)->SceneTaskLoop();
+    }
+
+    void SceneTaskLoop() {
+        for (;;) {
+            xSemaphoreTake(scene_signal_, portMAX_DELAY);
+            std::vector<SceneStep> steps;
+            uint32_t generation = 0;
+            if (xSemaphoreTake(scene_lock_, portMAX_DELAY) == pdTRUE) {
+                steps = std::move(scene_pending_);
+                scene_pending_.clear();
+                scene_cancel_requested_.store(false, std::memory_order_release);
+                scene_active_.store(!steps.empty(), std::memory_order_release);
+                generation = scene_generation_.load(std::memory_order_acquire);
+                xSemaphoreGive(scene_lock_);
+            }
+            if (steps.empty()) continue;
+
+            const uint32_t start_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000ULL);
+            for (const auto& step : steps) {
+                while (!scene_cancel_requested_.load(std::memory_order_acquire) &&
+                       scene_generation_.load(std::memory_order_acquire) == generation) {
+                    const uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000ULL);
+                    const uint32_t elapsed = now - start_ms;
+                    if (elapsed >= step.at_ms) break;
+                    vTaskDelay(pdMS_TO_TICKS(std::min<uint32_t>(step.at_ms - elapsed, 20)));
+                }
+                if (scene_cancel_requested_.load(std::memory_order_acquire) ||
+                    scene_generation_.load(std::memory_order_acquire) != generation) break;
+                ApplySceneStep(step);
+            }
+            WriteNanoDriveCommand("ST");
+            scene_active_.store(false, std::memory_order_release);
+            bool has_more = false;
+            if (xSemaphoreTake(scene_lock_, portMAX_DELAY) == pdTRUE) {
+                has_more = !scene_pending_.empty();
+                xSemaphoreGive(scene_lock_);
+            }
+            if (has_more) xSemaphoreGive(scene_signal_);
+        }
+    }
+
+    void CancelScenePlayback(const char* reason) {
+        if (scene_lock_ == nullptr) return;
+        if (xSemaphoreTake(scene_lock_, portMAX_DELAY) == pdTRUE) {
+            scene_pending_.clear();
+            scene_cancel_requested_.store(true, std::memory_order_release);
+            scene_generation_.fetch_add(1, std::memory_order_release);
+            xSemaphoreGive(scene_lock_);
+        }
+        WriteNanoDriveCommand("ST");
+        ESP_LOGI(TAG, "scene playback cancelled: %s", reason != nullptr ? reason : "unknown");
+    }
+
+    void InitializeSceneTask() {
+        if (scene_task_ != nullptr) return;
+        scene_lock_ = xSemaphoreCreateMutex();
+        scene_signal_ = xSemaphoreCreateBinary();
+        if (scene_lock_ == nullptr || scene_signal_ == nullptr) {
+            ESP_LOGE(TAG, "Failed to create scene sync primitives");
+            return;
+        }
+        if (xTaskCreate(&StackChanBoard::SceneTaskTrampoline, "scene_play", 4096, this,
+                        tskIDLE_PRIORITY + 2, &scene_task_) != pdPASS) {
+            ESP_LOGE(TAG, "Failed to create scene_play task");
+            vSemaphoreDelete(scene_lock_);
+            vSemaphoreDelete(scene_signal_);
+            scene_lock_ = nullptr;
+            scene_signal_ = nullptr;
+        } else {
+            ESP_LOGI(TAG, "Scene playback task ready");
+        }
+    }
