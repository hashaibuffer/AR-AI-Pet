+                    return root;
+                }
+                if (xSemaphoreTake(scene_lock_, portMAX_DELAY) == pdTRUE) {
+                    scene_pending_ = std::move(steps);
+                    scene_cancel_requested_.store(true, std::memory_order_release);
+                    scene_generation_.fetch_add(1, std::memory_order_release);
+                    xSemaphoreGive(scene_lock_);
+                }
+                xSemaphoreGive(scene_signal_);
+                cJSON_AddBoolToObject(root, "ok", true);
