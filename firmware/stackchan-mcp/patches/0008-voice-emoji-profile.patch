--- a/firmware/main/Kconfig.projbuild
+++ b/firmware/main/Kconfig.projbuild
@@ -18,6 +18,35 @@ config STACKCHAN_MCP_ACTION_GATEWAY_TOKEN
     help
         Optional bearer token for the Kimito action MCP gateway.

+config STACKCHAN_ACTION_GATEWAY
+    bool "Enable separate Kimito action gateway client"
+    default n
+    depends on BOARD_TYPE_STACKCHAN
+    help
+        Start the optional second WebSocket client used by Kimito's external
+        action gateway. This is independent from the local StackChan MCP
+        tool registry, so the robot can expose local actions without opening
+        a second socket.
+
+config STACKCHAN_AVATAR_OVERLAY
+    bool "Enable Kimito avatar overlay"
+    default n
+    depends on BOARD_TYPE_STACKCHAN
+    help
+        Enable the optional full-screen Kimito avatar and mouth-animation
+        layer. When disabled, the official Xiaozhi/LVGL emoji renderer stays
+        visible and the avatar MCP tools are not registered.
+
+config STACKCHAN_ACTION_MCP
+    bool "Enable local action MCP and robot tool transport"
+    default n
+    depends on BOARD_TYPE_STACKCHAN
+    help
+        Enable the local StackChan robot-tool registry (head, Emoji, LED,
+        sensor and NanoDrive actions). ESP-NOW remote and NanoDrive BLE are
+        retained independently. The separate action WebSocket is controlled
+        by STACKCHAN_ACTION_GATEWAY.
+
 choice STACKCHAN_VOICE_MODE
     prompt "StackChan voice interaction mode"
     default STACKCHAN_VOICE_MODE_MCP_SINGLE_SHOT
