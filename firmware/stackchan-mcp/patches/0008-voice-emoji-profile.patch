new file mode 100644
index 0000000..6c3a192
--- /dev/null
+++ b/firmware/configs/transport/xiaozhi-voice-only.defaults
@@ -0,0 +1,18 @@
+# Official Xiaozhi owns the primary voice/session connection. No local action
+# MCP socket is started in this profile, leaving the SRAM budget to voice,
+# OTA/activation and the built-in Emoji renderer.
+# CONFIG_DISABLE_OTA_WEBSOCKET_CONFIG is not set
+# CONFIG_FORCE_DEFAULT_WEBSOCKET_URL is not set
+CONFIG_DEFAULT_WEBSOCKET_URL=""
+CONFIG_DEFAULT_WEBSOCKET_FALLBACK_URL=""
+CONFIG_DEFAULT_WEBSOCKET_TOKEN=""
+CONFIG_STACKCHAN_MCP_ACTION_GATEWAY_URL=""
+CONFIG_STACKCHAN_MCP_ACTION_GATEWAY_TOKEN=""
+# Local robot tools stay available to the primary Xiaozhi session. The
+# separate action gateway socket remains disabled in this profile.
+CONFIG_STACKCHAN_ACTION_MCP=y
+# CONFIG_STACKCHAN_ACTION_GATEWAY is not set
+# CONFIG_STACKCHAN_AVATAR_OVERLAY is not set
+CONFIG_STACKCHAN_VOICE_MODE_XIAOZHI_CONVERSATIONAL=y
+# CONFIG_STACKCHAN_VOICE_MODE_MCP_SINGLE_SHOT is not set
+CONFIG_STACKCHAN_TOUCH_PTT=y
