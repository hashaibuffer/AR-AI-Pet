+        transport.Start();
         if (!transport.IsReady()) return false;
         if (!transport.IsMotionEnabled()) {
@@ -7887,9 +7891,8 @@ public:
         }
         companion_transports_started_ = true;
-        ESP_LOGI(TAG, "Starting deferred ESP-NOW remote and NanoDrive BLE transports");
+        ESP_LOGI(TAG, "Starting deferred ESP-NOW remote; NanoDrive BLE is lazy-started on base use");
         InitializeEspNowController();
-        NanoDriveBleScanner::GetInstance().Start();
         SystemInfo::PrintHeapStats();
     }
