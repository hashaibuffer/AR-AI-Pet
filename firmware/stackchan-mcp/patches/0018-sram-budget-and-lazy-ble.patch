diff --git a/firmware/main/Kconfig.projbuild b/firmware/main/Kconfig.projbuild
--- a/firmware/main/Kconfig.projbuild
+++ b/firmware/main/Kconfig.projbuild
@@ -70,6 +70,17 @@ config STACKCHAN_AGENT_PERIPHERAL_TOOLS
         for the voice demo when only the built-in Emoji/LED output is needed.
 
+config STACKCHAN_AGENT_MINIMAL_TOOLS
+    bool "Expose only the fixed voice-demo action tools"
+    default n
+    depends on BOARD_TYPE_STACKCHAN
+    depends on STACKCHAN_ACTION_MCP
+    help
+        Keep only scene.play, scene.stop, display.set_emotion,
+        robot.set_head_angles and led.set_color in the primary voice MCP
+        session. This is intended for low-memory voice builds; the full
+        engineering tool registry remains available when disabled.
+
 choice STACKCHAN_VOICE_MODE
     prompt "StackChan voice interaction mode"
diff --git a/firmware/configs/transport/xiaozhi-voice-only.defaults b/firmware/configs/transport/xiaozhi-voice-only.defaults
--- a/firmware/configs/transport/xiaozhi-voice-only.defaults
+++ b/firmware/configs/transport/xiaozhi-voice-only.defaults
@@ -19,6 +19,7 @@ CONFIG_STACKCHAN_ACTION_MCP=y
 # Keep the voice session's MCP list small. Diagnostic and external-port tools
 # are build-time opt-in and are not needed for the demo interaction loop.
 # CONFIG_STACKCHAN_AGENT_DIAGNOSTIC_TOOLS is not set
 # CONFIG_STACKCHAN_AGENT_PERIPHERAL_TOOLS is not set
+CONFIG_STACKCHAN_AGENT_MINIMAL_TOOLS=y
 # CONFIG_STACKCHAN_ACTION_GATEWAY is not set
diff --git a/firmware/main/mcp_server.cc b/firmware/main/mcp_server.cc
--- a/firmware/main/mcp_server.cc
+++ b/firmware/main/mcp_server.cc
@@ -33,1 +33,8 @@
 void McpServer::AddCommonTools() {
+#if CONFIG_STACKCHAN_AGENT_MINIMAL_TOOLS
+    // The voice-demo profile exposes only the small StackChan action set
+    // below. Common tools (camera, screen, volume and device status) are
+    // useful in the engineering profile but make the TLS/MCP handshake
+    // unnecessarily large on the ESP32-S3.
+    return;
+#endif
     // *Important* To speed up the response time, we add the common tools to the beginning of
@@ -310,1 +310,15 @@
 void McpServer::AddTool(McpTool* tool) {
+#if CONFIG_STACKCHAN_AGENT_MINIMAL_TOOLS
+    const std::string& name = tool->name();
+    const bool keep =
+        name == "self.scene.play" ||
+        name == "self.scene.stop" ||
+        name == "self.display.set_emotion" ||
+        name == "self.robot.set_head_angles" ||
+        name == "self.led.set_color";
+    if (!keep) {
+        ESP_LOGI(TAG, "Skip voice-demo MCP tool: %s", name.c_str());
+        delete tool;
+        return;
+    }
+#endif
     // Prevent adding duplicate tools
