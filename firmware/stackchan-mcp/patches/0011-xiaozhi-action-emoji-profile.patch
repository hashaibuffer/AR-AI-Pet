+# Official Xiaozhi remains the primary voice/session transport. The second
+# WebSocket is action-only and is populated by configure_stackchan.py.
+# CONFIG_DISABLE_OTA_WEBSOCKET_CONFIG is not set
+# CONFIG_FORCE_DEFAULT_WEBSOCKET_URL is not set
+CONFIG_DEFAULT_WEBSOCKET_URL=""
+CONFIG_DEFAULT_WEBSOCKET_FALLBACK_URL=""
+CONFIG_DEFAULT_WEBSOCKET_TOKEN=""
+CONFIG_STACKCHAN_ACTION_MCP=y
+CONFIG_STACKCHAN_ACTION_GATEWAY=y
+# Keep the built-in LVGL/Twemoji Emoji renderer visible on the LCD.
+# CONFIG_STACKCHAN_AVATAR_OVERLAY is not set
