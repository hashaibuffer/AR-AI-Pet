diff --git a/firmware/main/boards/stackchan/stackchan.cc b/firmware/main/boards/stackchan/stackchan.cc
index 97b1a50..2ca8197 100644
--- a/firmware/main/boards/stackchan/stackchan.cc
+++ b/firmware/main/boards/stackchan/stackchan.cc
@@ -528,0 +529,8 @@ private:
+    // NanoDrive uses Port C as a TX-only UART. RX remains disconnected until
+    // a 5 V -> 3.3 V level shifter is available, so a successful write means
+    // only that the command left StackChan, not that the base acknowledged it.
+    bool nanodrive_uart_ok_ = false;
+    static constexpr uart_port_t NANODRIVE_UART_PORT = UART_NUM_2;
+    static constexpr gpio_num_t NANODRIVE_TX_PIN = GPIO_NUM_17;
+    static constexpr int NANODRIVE_BAUD = 115200;
+    static constexpr int NANODRIVE_MAX_SPEED = 180;
@@ -2275,0 +2284,69 @@ private:
+    bool WriteNanoDriveCommand(const std::string& command) {
+        if (!nanodrive_uart_ok_ || command.empty()) {
+            return false;
+        }
+        std::string line = command;
+        line.push_back('\n');
+        int written = uart_write_bytes(NANODRIVE_UART_PORT, line.data(), line.size());
+        if (written != static_cast<int>(line.size())) {
+            ESP_LOGE(TAG, "NanoDrive UART write failed: %s", command.c_str());
+            return false;
+        }
+        if (uart_wait_tx_done(NANODRIVE_UART_PORT, pdMS_TO_TICKS(100)) != ESP_OK) {
+            ESP_LOGE(TAG, "NanoDrive UART TX timeout: %s", command.c_str());
+            return false;
+        }
+        ESP_LOGI(TAG, "NanoDrive TX: %s", command.c_str());
+        return true;
+    }
+
+    esp_err_t InitializeNanoDriveUart() {
+        if (nanodrive_uart_ok_) {
+            return ESP_OK;
+        }
+        if (port_c_ws2812_handle_ != nullptr) {
+            ESP_LOGE(TAG, "NanoDrive cannot claim Port C while WS2812 is active");
+            return ESP_ERR_INVALID_STATE;
+        }
+
+        uart_config_t config = {
+            .baud_rate = NANODRIVE_BAUD,
+            .data_bits = UART_DATA_8_BITS,
+            .parity = UART_PARITY_DISABLE,
+            .stop_bits = UART_STOP_BITS_1,
+            .flow_ctrl = UART_HW_FLOWCTRL_DISABLE,
+            .rx_flow_ctrl_thresh = 0,
+            .source_clk = UART_SCLK_DEFAULT,
+            .flags = {},
+        };
+        esp_err_t err = uart_driver_install(NANODRIVE_UART_PORT, 256, 256, 0, nullptr, 0);
+        if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
+            ESP_LOGE(TAG, "NanoDrive uart_driver_install failed: %s", esp_err_to_name(err));
+            return err;
+        }
+        if ((err = uart_param_config(NANODRIVE_UART_PORT, &config)) != ESP_OK) {
+            ESP_LOGE(TAG, "NanoDrive uart_param_config failed: %s", esp_err_to_name(err));
+            return err;
+        }
+        if ((err = uart_set_pin(NANODRIVE_UART_PORT, NANODRIVE_TX_PIN,
+                                UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE,
+                                UART_PIN_NO_CHANGE)) != ESP_OK) {
+            ESP_LOGE(TAG, "NanoDrive uart_set_pin failed: %s", esp_err_to_name(err));
+            return err;
+        }
+
+        nanodrive_uart_ok_ = true;
+        ESP_LOGI(TAG, "NanoDrive TX-only UART ready: UART%d GPIO%d %d baud",
+                 static_cast<int>(NANODRIVE_UART_PORT),
+                 static_cast<int>(NANODRIVE_TX_PIN), NANODRIVE_BAUD);
+        WriteNanoDriveCommand("ST");
+        WriteNanoDriveCommand("TO:2000");
+        return ESP_OK;
+    }
+
+    bool SendNanoDriveMotion(const std::string& command) {
+        return nanodrive_uart_ok_ &&
+               WriteNanoDriveCommand("EN:1") &&
+               WriteNanoDriveCommand(command);
+    }
+
@@ -7083,0 +7161,55 @@ private:
+        mcp_server.AddTool(
+            "self.robot.base_move",
+            "Move the NanoDrive base in one of four directions. direction must be "
+            "forward, backward, left, or right; speed is 0..180. The command "
+            "path is TX-only and the base watchdog stops motion after 2000 ms.",
+            PropertyList({
+                Property("direction", kPropertyTypeString, std::string("forward")),
+                Property("speed", kPropertyTypeInteger, 80, 0, NANODRIVE_MAX_SPEED)
+            }),
+            [this](const PropertyList& properties) -> ReturnValue {
+                const std::string direction = properties["direction"].value<std::string>();
+                const int speed = std::clamp(properties["speed"].value<int>(),
+                                             0, NANODRIVE_MAX_SPEED);
+                const char* operation = nullptr;
+                if (direction == "forward") operation = "FW";
+                else if (direction == "backward") operation = "BW";
+                else if (direction == "left") operation = "TL";
+                else if (direction == "right") operation = "TR";
+                if (operation == nullptr) {
+                    ESP_LOGW(TAG, "Rejected NanoDrive direction: %s", direction.c_str());
+                    return false;
+                }
+                return SendNanoDriveMotion(std::string(operation) + ":" +
+                                           std::to_string(speed));
+            });
+
+        mcp_server.AddTool(
+            "self.robot.base_drive",
+            "Set NanoDrive left and right wheel speeds independently. Each value "
+            "is -180..180. This TX-only command is still protected by the base "
+            "watchdog.",
+            PropertyList({
+                Property("left", kPropertyTypeInteger, 0, -NANODRIVE_MAX_SPEED,
+                         NANODRIVE_MAX_SPEED),
+                Property("right", kPropertyTypeInteger, 0, -NANODRIVE_MAX_SPEED,
+                         NANODRIVE_MAX_SPEED)
+            }),
+            [this](const PropertyList& properties) -> ReturnValue {
+                const int left = std::clamp(properties["left"].value<int>(),
+                                            -NANODRIVE_MAX_SPEED, NANODRIVE_MAX_SPEED);
+                const int right = std::clamp(properties["right"].value<int>(),
+                                             -NANODRIVE_MAX_SPEED, NANODRIVE_MAX_SPEED);
+                return SendNanoDriveMotion("VL:" + std::to_string(left) + "," +
+                                           std::to_string(right));
+            });
+
+        mcp_server.AddTool(
+            "self.robot.base_stop",
+            "Immediately send the NanoDrive emergency-stop command. The next "
+            "movement command explicitly re-enables the base before moving.",
+            PropertyList(),
+            [this](const PropertyList&) -> ReturnValue {
+                return WriteNanoDriveCommand("ST");
+            });
+
@@ -7117,0 +7251 @@ public:
+        InitializeNanoDriveUart();
