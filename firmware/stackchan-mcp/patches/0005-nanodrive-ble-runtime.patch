     auto event_group = static_cast<EventGroupHandle_t>(event_group_);
     xEventGroupWaitBits(event_group, kScanParamsReady, pdFALSE, pdTRUE, portMAX_DELAY);
     while (true) {
+        if (connecting_ || connected_) {
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
         ++scan_cycle_;
         ResetCycle();
         xEventGroupClearBits(event_group, kScanComplete);
