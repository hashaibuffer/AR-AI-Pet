+void NanoDriveBleScanner::HandleGattcEvent(esp_gattc_cb_event_t event,
+                                            esp_gatt_if_t gattc_if,
+                                            esp_ble_gattc_cb_param_t* param) {
+    if (param == nullptr) return;
+    if (event == ESP_GATTC_REG_EVT) {
+        if (param->reg.status != ESP_GATT_OK) {
+            ESP_LOGE(TAG, "GATTC registration failed status=%d", param->reg.status);
+            return;
+        }
+        gattc_if_ = gattc_if;
+        gattc_registered_ = true;
+        ESP_LOGI(TAG, "GATTC app registered if=%u", static_cast<unsigned>(gattc_if));
+        if (!target_seen_) {
+            std::memcpy(target_address_, kTargetAddress, kAddressSize);
+            target_address_type_ = BLE_ADDR_TYPE_PUBLIC;
+            target_seen_ = true;
+            ESP_LOGI(TAG, "attempting direct GATT open using previously observed address");
+        }
+        OpenTargetIfReady();
+        return;
+    }
+    if (event == ESP_GATTC_OPEN_EVT) {
+        ESP_LOGI(TAG, "GATTC open status=%d conn_id=%u mtu=%u",
+                 param->open.status,
+                 static_cast<unsigned>(param->open.conn_id),
+                 static_cast<unsigned>(param->open.mtu));
+        if (param->open.status != ESP_GATT_OK) {
+            connecting_ = false;
+            target_seen_ = false;
+        }
+        return;
+    }
+    if (event == ESP_GATTC_CONNECT_EVT) {
+        connecting_ = false;
+        connected_ = true;
+        conn_id_ = param->connect.conn_id;
+        gattc_if_ = gattc_if;
+        ESP_LOGI(TAG, "GATTC connected conn_id=%u; requesting MTU",
+                 static_cast<unsigned>(conn_id_));
+        esp_ble_gattc_send_mtu_req(gattc_if_, conn_id_);
+        return;
+    }
+    if (event == ESP_GATTC_CFG_MTU_EVT) {
+        ESP_LOGI(TAG, "GATTC MTU status=%d mtu=%u; discovering services",
+                 param->cfg_mtu.status, static_cast<unsigned>(param->cfg_mtu.mtu));
+        if (param->cfg_mtu.status == ESP_GATT_OK) {
+            esp_ble_gattc_search_service(gattc_if_, conn_id_, nullptr);
+        }
+        return;
+    }
+    if (event == ESP_GATTC_SEARCH_RES_EVT) {
+        const auto& service = param->search_res;
+        char uuid[40]{};
+            FormatUuid(service.srvc_id.uuid, uuid, sizeof(uuid));
+        ESP_LOGI(TAG, "GATT service primary=%d start=%u end=%u uuid=%s",
+                 service.is_primary ? 1 : 0,
+                 static_cast<unsigned>(service.start_handle),
+                 static_cast<unsigned>(service.end_handle), uuid);
+        return;
+    }
+    if (event == ESP_GATTC_SEARCH_CMPL_EVT) {
+        ESP_LOGI(TAG, "GATT service discovery complete status=%d", param->search_cmpl.status);
+        if (param->search_cmpl.status == ESP_GATT_OK) {
+            uint16_t count = 0;
+            esp_gatt_status_t err = esp_ble_gattc_get_attr_count(
+                gattc_if_, conn_id_, ESP_GATT_DB_CHARACTERISTIC, 1, 0xFFFF, 0, &count);
+            if (err == ESP_OK && count > 0) {
+                std::vector<esp_gattc_char_elem_t> chars(count);
+                err = esp_ble_gattc_get_all_char(gattc_if_, conn_id_, 1, 0xFFFF,
+                                                  chars.data(), &count, 0);
+                if (err == ESP_OK) {
+                    for (uint16_t i = 0; i < count; ++i) {
+                        char uuid[40]{};
+                        FormatUuid(chars[i].uuid, uuid, sizeof(uuid));
+                        ESP_LOGI(TAG, "GATT characteristic handle=%u uuid=%s properties=0x%02X",
+                                 static_cast<unsigned>(chars[i].char_handle), uuid,
+                                 static_cast<unsigned>(chars[i].properties));
+                        // This module's FFE1 is the transparent UART write
+                        // characteristic; FFE2 is reserved for its auxiliary
+                        // IO/configuration path. Prefer FFE1 for A/E/Z bytes.
+                        if (chars[i].uuid.len == ESP_UUID_LEN_16 &&
+                            chars[i].uuid.uuid.uuid16 == 0xFFE1 &&
+                            (chars[i].properties & (ESP_GATT_CHAR_PROP_BIT_WRITE |
+                                                    ESP_GATT_CHAR_PROP_BIT_WRITE_NR)) != 0) {
+                            write_handle_ = chars[i].char_handle;
+                        }
+                    }
+                    if (write_handle_ != 0 && !safe_stop_sent_) {
+                        if (SendCommand('Z')) {
+                            safe_stop_sent_ = true;
+                            ESP_LOGI(TAG, "safe stop Z write requested handle=%u",
+                                     static_cast<unsigned>(write_handle_));
+                        } else {
+                            ESP_LOGE(TAG, "safe stop Z write request failed");
+                        }
+                    }
+                }
+            }
+        }
+        return;
+    }
+    if (event == ESP_GATTC_WRITE_CHAR_EVT) {
+        ESP_LOGI(TAG, "GATT characteristic write status=%d handle=%u",
+                 param->write.status, static_cast<unsigned>(param->write.handle));
+        if (param->write.status == ESP_GATT_OK && param->write.handle == write_handle_ &&
+            safe_stop_sent_ && kRunOneMotionTest && !motion_test_started_) {
+            motion_test_started_ = true;
+            if (xTaskCreate(MotionTestTaskTrampoline, "nanodrive_motion_test", 3072, this, 4,
+                            nullptr) != pdPASS) {
+                motion_test_started_ = false;
+                ESP_LOGE(TAG, "motion test task creation failed; keeping safe stop");
+            }
+        }
+        return;
+    }
+    if (event == ESP_GATTC_DISCONNECT_EVT) {
+        ESP_LOGW(TAG, "GATTC disconnected reason=0x%02X", param->disconnect.reason);
+        connected_ = false;
+        connecting_ = false;
+        target_seen_ = false;
+        write_handle_ = 0;
+        safe_stop_sent_ = false;
+    }
+}
