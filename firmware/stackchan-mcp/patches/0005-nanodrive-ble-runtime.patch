+
+void NanoDriveBleScanner::MotionTestTask() {
+    auto write_motion = [this](std::uint8_t command) { return SendCommand(command); };
+
+    vTaskDelay(pdMS_TO_TICKS(300));
+    write_motion('A');
+    vTaskDelay(pdMS_TO_TICKS(1000));
+    write_motion('Z');
+    vTaskDelay(pdMS_TO_TICKS(500));
+    write_motion('E');
+    vTaskDelay(pdMS_TO_TICKS(1000));
+    write_motion('Z');
+    ESP_LOGI(TAG, "one-shot motion test complete; final command Z");
+    vTaskDelete(nullptr);
+}
+
