+void NanoDriveBleScanner::OpenTargetIfReady() {
+    if (!gattc_registered_ || connecting_ || connected_ || !target_seen_) return;
+    connecting_ = true;
+    const esp_err_t err = esp_ble_gattc_open(
+        gattc_if_, target_address_, static_cast<esp_ble_addr_type_t>(target_address_type_), true);
+    if (err != ESP_OK) {
+        connecting_ = false;
+        target_seen_ = false;
+        ESP_LOGE(TAG, "GATTC open failed: %s", esp_err_to_name(err));
+    } else {
+        ESP_LOGI(TAG, "GATTC open requested for confirmed target");
+    }
+}
