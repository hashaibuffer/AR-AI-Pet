@@ -469,7 +470,7 @@ npm run tts-shim       # 可选 TTS shim 在 127.0.0.1:8769
 | `WHISPER_REMOTE_URL` | 空 | 远端 STT 优先，失败静默回退本地 |
 | `WHISPER_REMOTE_TOKEN` | 空 | 远端 STT 的 Bearer |
 | `WHISPER_REMOTE_TIMEOUT_S` | `4` | 远端 STT 超时 |
-| `COMPANION_STT_LANGUAGES` | 空 | 预期语言表；检出表外语言按第一项强制重转（长录豁免） |
+| `COMPANION_STT_LANGUAGES` | `zh` | 预期语言表；检出表外语言按第一项强制重转（长录豁免） |
 | `COMPANION_STT_HALLUCINATIONS` | 水印词表 | 含任一子串整条丢弃（whisper 近静音的字幕水印幻觉） |
 | **语音输出** | | |
 | `COMPANION_SAY_VOICE` | 空 | say 工具的音色名（空 = 设备默认） |
diff --git a/companion/companion.py b/companion/companion.py
index 843a4c1..e42e71b 100644
--- a/companion/companion.py
+++ b/companion/companion.py
@@ -72,6 +72,7 @@ def _on(name: str, default: str = "1") -> bool:
 
 # transport / device
 MCP_URL = os.getenv("STACKCHAN_MCP_URL", "http://127.0.0.1:8767/mcp")
+MCP_TOKEN = os.getenv("STACKCHAN_MCP_TOKEN", "")
 EVENTS_PATH = Path(os.getenv("STACKCHAN_EVENTS_JSONL",
                              str(Path.home() / ".stackchan/events.jsonl")))
 DEVICE_ID = os.getenv("STACKCHAN_DEVICE_ID", "")
@@ -96,7 +97,7 @@ WHISPER_REMOTE_TOKEN = os.getenv("WHISPER_REMOTE_TOKEN", "")
 WHISPER_REMOTE_TIMEOUT_S = _f("WHISPER_REMOTE_TIMEOUT_S", 4)
 # comma list of expected languages; a detection outside the list triggers one
 # retranscription forced to the first entry. Empty = trust detection.
-STT_LANGUAGES = [x.strip() for x in os.getenv("COMPANION_STT_LANGUAGES", "").split(",")
+STT_LANGUAGES = [x.strip() for x in os.getenv("COMPANION_STT_LANGUAGES", "zh").split(",")
                  if x.strip()]
 # Whisper's near-silence hallucinations are watermark-shaped: subtitle-credit
 # lines from its training data surface verbatim on empty audio. A transcript
@@ -307,6 +308,8 @@ def is_night(hour: int) -> bool:
 def mcp_call(tool: str, args: dict | None = None, timeout: float = 60.0):
     headers = {"Content-Type": "application/json",
                "Accept": "application/json, text/event-stream"}
+    if MCP_TOKEN:
+        headers["Authorization"] = "Bearer " + MCP_TOKEN
 
     def post(payload, session=None):
         h = dict(headers)
@@ -2476,7 +2479,9 @@ def transcribe(ogg_bytes: bytes, allow_any_lang: bool = False) -> str:
         # misread of a short, noisy clip — retranscribe forced to the primary.
         # Long captures are exempt (allow_any_lang): what a waiter or an
         # announcement says in a third language must reach the brain as-is.
-        if not allow_any_lang and STT_LANGUAGES and info.language not in STT_LANGUAGES:
+        allowed = {value.lower().split("-", 1)[0] for value in STT_LANGUAGES}
+        detected = (info.language or "").lower().split("-", 1)[0]
+        if not allow_any_lang and allowed and detected not in allowed:
             log.info("detected %s (p=%.2f) — retry as %s", info.language,
                      info.language_probability, STT_LANGUAGES[0])
             segments, info = model.transcribe(wav_path, language=STT_LANGUAGES[0],
@@ -2505,6 +2510,14 @@ def transcribe_remote(ogg_bytes: bytes) -> str | None:
         with urllib.request.urlopen(req, timeout=WHISPER_REMOTE_TIMEOUT_S) as r:
             data = json.loads(r.read().decode())
         text = (data.get("text") or "").strip()
+        detected = str(data.get("language") or "").lower().split("-", 1)[0]
+        allowed = {value.lower().split("-", 1)[0] for value in STT_LANGUAGES}
+        if detected and allowed and detected not in allowed:
+            # Reject an off-language remote result so the caller falls back
+            # to local Whisper, whose primary language is then forced.
+            log.info("stt remote language %s outside %s -> local retry",
+                     detected, sorted(allowed))
+            return None
         log.info("stt remote hit: %r (%s)", text[:40], data.get("language"))
         return text
     except Exception as exc:
