@@ -125,3 +157,15 @@ void espnow_send_data(uint8_t *pkt, size_t len)
     espnow_frame_head_t frame_head = ESPNOW_FRAME_CONFIG_DEFAULT();
     ESP_ERROR_CHECK(espnow_send(ESPNOW_DATA_TYPE_DATA, ESPNOW_ADDR_BROADCAST, pkt, len, &frame_head, portMAX_DELAY));
 }
+
+bool espnow_receive_data(uint8_t *pkt, size_t capacity, size_t *length)
+{
+    rx_packet_t received;
+    if (pkt == NULL || length == NULL || rx_queue == NULL ||
+        xQueueReceive(rx_queue, &received, 0) != pdTRUE || received.length > capacity) {
+        return false;
+    }
+    memcpy(pkt, received.data, received.length);
+    *length = received.length;
+    return true;
+}
