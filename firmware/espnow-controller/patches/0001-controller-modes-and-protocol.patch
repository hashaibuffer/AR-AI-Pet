@@ -4,6 +4,34 @@
  * SPDX-License-Identifier: MIT
  */
 #include "esp_now_init.h"
+#include "freertos/queue.h"
+
+#define RX_PACKET_MAX 64
+
+typedef struct {
+    size_t length;
+    uint8_t data[RX_PACKET_MAX];
+} rx_packet_t;
+
+static QueueHandle_t rx_queue;
+static uint8_t current_channel;
+
+static esp_err_t receive_data(uint8_t *src_addr, void *data, size_t size,
+                              wifi_pkt_rx_ctrl_t *rx_ctrl)
+{
+    (void)src_addr;
+    (void)rx_ctrl;
+    if (rx_queue == NULL || data == NULL || size > RX_PACKET_MAX) return ESP_ERR_INVALID_ARG;
+    rx_packet_t packet = {.length = size};
+    memcpy(packet.data, data, size);
+    return xQueueSend(rx_queue, &packet, 0) == pdTRUE ? ESP_OK : ESP_ERR_TIMEOUT;
+}
+
+static void enable_receive(void)
+{
+    if (rx_queue == NULL) rx_queue = xQueueCreate(8, sizeof(rx_packet_t));
+    ESP_ERROR_CHECK(espnow_set_config_for_data_type(ESPNOW_DATA_TYPE_DATA, true, receive_data));
+}
 
