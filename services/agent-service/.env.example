POSTGRES_DB=araipet
POSTGRES_USER=araipet
POSTGRES_PASSWORD=araipet
POSTGRES_PORT=5432
WS_PORT=8080
MCP_PORT=8081
DATA_SERVICE_WS_URL=ws://localhost:8080/ws
DATA_SERVICE_TIMEOUT_SECONDS=5
AGENT_GATEWAY_WS_URL=ws://localhost:8082/ws
MCP_URL=http://localhost:8081/mcp
AGENT_PORT=8082
AGENT_PROVIDER=openai
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ROUNDS=3
AGENT_TIMEZONE=Asia/Shanghai
PERSONA_ROOT=/app/content/runtime
PROTOCOL_ROOT=/app/packages/protocol
EXPERIENCE_TICK_SECONDS=5
MEMORY_PORT=8083
MEMORY_WS_URL=ws://localhost:8083/ws
MEMORY_PROVIDER=mock
MEMORY_SEARCH_TIMEOUT_SECONDS=2
MEMORY_WORKER_INTERVAL_SECONDS=2
MEMORY_MAX_ATTEMPTS=3
MEMORY_JOB_LEASE_SECONDS=60
MEMORY_RETRY_BASE_SECONDS=5
MEM0_ENABLED=false
MEM0_QDRANT_URL=http://localhost:6333
MEM0_COLLECTION=araipet_memories
MEM0_HISTORY_DB_PATH=/data/mem0-history.db
MEM0_LLM_PROVIDER=openai
MEM0_LLM_BASE_URL=https://api.openai.com/v1
MEM0_LLM_API_KEY=
MEM0_LLM_MODEL=gpt-4o-mini
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_BASE_URL=https://api.openai.com/v1
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMS=1536
FARM_TICK_SECONDS=30

# 仅供本机直接运行服务时使用；Docker Compose 会自动使用 postgres 作为主机名。
DATABASE_URL=postgresql+psycopg://araipet:araipet@localhost:5432/araipet
