POSTGRES_DB=araipet
POSTGRES_USER=araipet
POSTGRES_PASSWORD=araipet
POSTGRES_PORT=5432
WS_PORT=8080
MCP_PORT=8081
DATA_SERVICE_WS_URL=ws://localhost:8080/ws
DATA_SERVICE_TIMEOUT_SECONDS=5
MCP_URL=http://localhost:8081/mcp
AGENT_PORT=8082
AGENT_PROVIDER=openai
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ROUNDS=3
AGENT_TIMEZONE=Asia/Shanghai
FARM_TICK_SECONDS=30

# 仅供本机直接运行服务时使用；Docker Compose 会自动使用 postgres 作为主机名。
DATABASE_URL=postgresql+psycopg://araipet:araipet@localhost:5432/araipet
