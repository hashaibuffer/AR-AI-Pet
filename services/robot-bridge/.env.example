# Agent Gateway subscription endpoint
AGENT_GATEWAY_WS_URL=ws://127.0.0.1:8082/ws

# mock keeps CI and development hardware-free; stackchan enables the real adapter
ROBOT_ADAPTER=mock
ROBOT_DEVICE_ID=mock-robot

# StackChan MCP WebSocket endpoint used when ROBOT_ADAPTER=stackchan
STACKCHAN_WS_URL=ws://192.168.50.213:8080/ws
STACKCHAN_TOKEN=
STACKCHAN_CONNECT_TIMEOUT_SECONDS=10
# 0 means return after the MCP WebSocket write; the official gateway normally
# does not return a physical completion response.
STACKCHAN_RESPONSE_TIMEOUT_SECONDS=0
STACKCHAN_MAX_SPEED=180
STACKCHAN_MAX_DURATION_SECONDS=1.5
BRIDGE_RETRY_SECONDS=2
